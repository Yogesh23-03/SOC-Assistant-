# Copy to .env. Keep all actual secrets out of Git and the extension.
GROQ_API_KEY=
GROQ_MODEL=
MAX_RETRIES=2
SOC_HMAC_SECRET=
SOC_JWT_SECRET=
# fixture keeps demonstrations offline; live enables ingested-log and provider lookups.
SOC_DATA_MODE=fixture
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SOC_INTEL_CACHE_SECONDS=86400
SOC_REAPER_INTERVAL_SECONDS=30
# Enable only on the Linux target hosting the firewall, after reviewing the lab setup.
SOC_EXECUTE_ON_APPROVAL=false
