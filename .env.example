# Copy this file to .env and fill in your own values. Never commit .env.
# Keys only: this file ships with every value empty.

# From the Groq console. Required.
GROQ_API_KEY=

# A Groq chat model id your account can access, e.g. openai/gpt-oss-120b.
GROQ_MODEL=

# Extra attempts after the first failure; MAX_RETRIES=2 means up to 3 attempts.
MAX_RETRIES=
